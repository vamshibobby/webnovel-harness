# The only thing you need. Get one at https://openrouter.ai/keys
# (Optional here — you can paste it into the UI's Settings instead; the UI's key wins.)
OPENROUTER_API_KEY=

# Where novels, bibles, arcs, maps and covers are stored. Default: ./data
# DATA_DIR=./data

# API port (default 8787). The UI dev server runs on 5173 and proxies to it.
# PORT=8787

# Optional: have your usage appear under your own app name on openrouter.ai
# APP_URL=
# APP_TITLE=
